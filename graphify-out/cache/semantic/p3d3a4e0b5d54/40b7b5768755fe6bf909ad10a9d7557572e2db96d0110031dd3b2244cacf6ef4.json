{"nodes": [{"id": "claude_biobuzz_project", "label": "BIOBUZZ 2026-27 Robot Code Project", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_decode_legacy_code", "label": "DECODE Legacy Code (last season)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L3-L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuse its patterns but write new BIOBUZZ code; OLD-prefixed files are dead; DECODE copy-pasted 1000-line OpModes."}, {"id": "claude_pidf_override_file", "label": "PIDF Override File (biobuzz_pidf.txt)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L17-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gains saved by PIDF Tuner on the Control Hub override RobotConstants while the file exists."}, {"id": "claude_turret_fixed_mode", "label": "Temporary Fixed Turret Mode (TURRET_FIXED)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L27-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shooter and Limelight treated as bolted forward; aim by turning the whole chassis; turret motor never powered; MegaTag2 yaw = robot heading; flipping the flag later restores the turret."}, {"id": "claude_aimer_interface", "label": "Aimer Interface (ChassisAimer / TurretAimer)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L39-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aiming lives behind an interface so the rotating turret can return without rewriting callers."}, {"id": "claude_turret_rotation_limits", "label": "Turret Rotation Limits (wiring safety)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L52-L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No slip ring: Limelight USB and flywheel cables cross the joint, so angle is tracked unwrapped, soft limits +/-150 deg, all aiming via Turret.chooseSetpoint(), update() cuts power past limits or on stall."}, {"id": "claude_shotsolver", "label": "Shared ShotSolver (odometry feed-forward + Limelight tx)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L62-L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_flywheel_rpm_cap", "label": "Flywheel RPM Cap and POLLEN/NECTAR RPM Tables", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L49-L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard max 6000 RPM, default clamp RPM_CAP = 3500; RPM is motor-encoder RPM so gear ratio is not needed."}, {"id": "claude_localization_strategy", "label": "Localization: Pinpoint Odometry + Gated MegaTag2 x/y Corrections", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L72-L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Odometry is the single pose owner; vision corrects only x/y, gated, latency-compensated, median-filtered, partial, never heading; rejected while moving fast, during tips, <2 tags, or far away."}, {"id": "claude_apriltag_cell_ids", "label": "HIVE CELL AprilTag ID Clusters", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L65-L71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_field_frame_rotate180", "label": "Field Frame and rotate180 Symmetry", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L87-L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Field is 180 deg rotationally symmetric: blue = (144-x, 144-y, h+pi); never mirror one axis. One AUTO per route built for red."}, {"id": "claude_rules_enforced_in_code", "label": "Game Rules the Code Must Enforce", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L90-L98", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_hardware_names", "label": "Robot Hardware Configuration Names (no servos)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L99-L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feeder motor gates balls into the flywheel, so it must stay off while intaking."}, {"id": "claude_tip_threshold", "label": "TIP Threshold (BALLS_TO_TIP = 8)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L103-L104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_unknown_values_placeholders", "label": "Unknown Values as Named Placeholders + Calibration OpModes", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L105-L111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Don't block on or invent numbers; keep placeholders in RobotConstants and measure them with calibration OpModes."}, {"id": "claude_shared_class_extraction", "label": "Code Style: Extract Shared Classes", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L113-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoid DECODE's copy-pasted 1000-line OpModes."}], "edges": [{"source": "claude_biobuzz_project", "target": "claude_decode_legacy_code", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L3-L5", "weight": 1.0}, {"source": "claude_biobuzz_project", "target": "docs_biobuzz_biobuzz_rules_biobuzz_game", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLA