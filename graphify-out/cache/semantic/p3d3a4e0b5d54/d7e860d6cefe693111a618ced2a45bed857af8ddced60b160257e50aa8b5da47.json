l, "contributor": null}, {"id": "docs_biobuzz_turret_limelight_brief_localizer", "label": "Localizer (one pose, one owner)", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L297", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DECODE set pose in two places (pinpoint and follower); use Pedro follower as sole owner in AUTO and teleop."}, {"id": "docs_biobuzz_turret_limelight_brief_pinpoint_odometry", "label": "Pinpoint odometry (main pose + heading source)", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L309", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biobuzz_turret_limelight_brief_pod_offsets_disagreement", "label": "Pinpoint pod offsets disagreement (MainTeleop 0,0 vs Constants -6/10 mm)", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L313", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biobuzz_turret_limelight_brief_megatag2_correction", "label": "MegaTag2 x/y vision correction", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L334", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heading never corrected because MegaTag2 takes heading as input; corrections are gated, latency-compensated, median-filtered and partial (alpha 0.5-0.7) to avoid pose snaps."}, {"id": "docs_biobuzz_turret_limelight_brief_vision_gates", "label": "Vision frame gates (>=2 tags, <2.2 m, <15 in/s, <45 deg/s, no TIP)", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L372", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biobuzz_turret_limelight_brief_latency_compensation", "label": "Latency compensation + median offset window", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L386", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biobuzz_turret_limelight_brief_frame_conversion_helper", "label": "Limelight<->Pedro frame conversion helper (position + heading)", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L349", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biobuzz_turret_limelight_brief_aim_fine_tuning", "label": "Aim fine-tuning (per-frame tx correction)", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L413", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept separate from slow localization corrections; don't merge the two Limelight uses."}, {"id": "docs_biobuzz_turret_limelight_brief_turret_rotation_limits", "label": "Turret rotation limits (cable wrap protection, +/-150 deg)", "file_type": "rationale", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L435", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No slip ring: Limelight USB and flywheel cables cross the joint, so the turret must never make a full turn; angle tracked unwrapped from home."}, {"id": "docs_biobuzz_turret_limelight_brief_turret_choosesetpoint", "label": "Turret.chooseSetpoint(desiredYaw)", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L481", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biobuzz_turret_limelight_brief_turret_update", "label": "Turret.update() motor-layer enforcement", "file_type": "concept", "source_file": "docs/biobuzz/TURRET_LIMELIGHT_BRIEF.md", "source_location": "L504", "source_url": null, "captured_at": null, "au